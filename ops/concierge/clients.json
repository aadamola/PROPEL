{
  "_meta": {
    "purpose": "Client registry. Adding client #2 is a row here, not a new workflow.",
    "rule": "Every workflow reads this. Nothing about a client is hardcoded in a node.",
    "defaults": {
      "model": "gemini-flash-latest",
      "api_version": "v1beta",
      "_note": "Model ID lives here, not in a node URL. Confirm against your key with: curl -s \"https://generativelanguage.googleapis.com/v1beta/models?key=$KEY\" | grep '\"name\"'"
    }
  },
  "clients": {
